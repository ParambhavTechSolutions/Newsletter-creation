# Copy to .env and fill in. Never commit .env.

# Groq - research (browser search) + writing (research_topic.py, write_newsletter.py)
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-120b)
GROQ_MODEL=

# Cloudflare Workers AI - free image generation (generate_ai_infographic.py)
# dash.cloudflare.com -> Workers AI -> Use REST API: copy Account ID, create an API token (Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google Sheet for the newsletter archive (archive_to_sheets.py creates one and fills this in if empty)
NEWSLETTER_SHEET_ID=
