{% extends "base.html.j2" %}
{# g.chart: {kind: bar|hbar|line|doughnut, labels: [...], unit: "%",
             datasets: [{label: "...", data: [..], highlight_index: optional int}]} #}
{% block style %}
  .wrap { position: relative; height: {{ g.chart.height or 300 }}px; }
  .legend { display: flex; gap: 18px; margin-top: 14px; font: 600 12.5px/1 "Inter", Arial, sans-serif; color: var(--fg2); flex-wrap: wrap; }
  .legend span { display: inline-flex; align-items: center; gap: 7px; }
  .legend i { width: 12px; height: 12px; display: inline-block; border: 1px solid var(--shadow); }
{% endblock %}
{% block body %}
<div class="wrap"><canvas id="c"></canvas></div>
{% if g.chart.datasets|length > 1 or g.chart.kind == "doughnut" %}<div class="legend" id="legend"></div>{% endif %}
{% endblock %}
{% block script %}
<script src="{{ chartjs }}"></script>
<script>
(async () => {
  await document.fonts.ready;
  const spec = {{ g.chart | tojson }};
  const dark = {{ (g.theme == "dark") | tojson }};
  const ramp = {{ ramp | tojson }};
  // On dark cards the ramp runs light → dark so the first series stays visible.
  const colors = dark ? [ramp[4], ramp[3], ramp[2], "#5A616B", "#3A3F47"] : ramp;
  const fg = dark ? "{{ c.white }}" : "{{ c.charcoal }}";
  const fg2 = dark ? "{{ c.silver }}" : "{{ c.charcoal }}";
  const grid = dark ? "#2A2D33" : "{{ c.silver }}";
  const unit = spec.unit || "";
  const fmt = v => (typeof v === "number" ? v.toLocaleString("en-US") : v) + (unit === "%" ? "%" : unit ? " " + unit : "");
  Chart.defaults.font.family = "Inter, Arial, sans-serif";
  Chart.defaults.font.size = 13;
  Chart.defaults.color = fg2;

  const kind = spec.kind || "bar";
  const isH = kind === "hbar";
  const type = isH ? "bar" : kind;
  // Multi-series bar/line: skip adjacent ramp tones (black vs charcoal look identical) so series stay distinguishable.
  const seriesOrder = dark ? [0, 2, 1, 3, 4] : [0, 3, 2, 1, 4];
  const datasets = spec.datasets.map((d, i) => {
    const base = colors[seriesOrder[i % seriesOrder.length]];
    if (type === "doughnut") {
      return { ...d, backgroundColor: d.data.map((_, j) => colors[j % colors.length]),
               borderColor: dark ? "{{ c.primary_black }}" : "{{ c.white }}", borderWidth: 3 };
    }
    if (type === "line") {
      return { ...d, borderColor: base, backgroundColor: base, borderWidth: 3, pointRadius: 5,
               pointBackgroundColor: dark ? "{{ c.primary_black }}" : "{{ c.white }}", pointBorderWidth: 3,
               borderDash: i ? [6, 4] : [], tension: 0.25 };
    }
    // bar: single series gets one emphasized bar (highlight_index) in the strongest tone
    let bg = base;
    if (spec.datasets.length === 1 && d.highlight_index != null) {
      bg = d.data.map((_, j) => j === d.highlight_index ? colors[0] : colors[dark ? 2 : 3]);
    }
    return { ...d, backgroundColor: bg, borderRadius: 2, maxBarThickness: 56 };
  });

  // Direct value labels so meaning never depends on colour alone (WCAG / brand guideline 08).
  const valueLabels = {
    id: "valueLabels",
    afterDatasetsDraw(chart) {
      const { ctx } = chart;
      ctx.save();
      ctx.font = "700 13px Inter, Arial, sans-serif";
      chart.data.datasets.forEach((ds, i) => {
        const meta = chart.getDatasetMeta(i);
        if (meta.hidden) return;
        meta.data.forEach((el, j) => {
          const v = ds.data[j];
          if (v == null) return;
          if (type === "doughnut") {
            const p = el.tooltipPosition();
            const total = ds.data.reduce((a, b) => a + b, 0);
            if (v / total < 0.06) return;
            const bgc = Array.isArray(ds.backgroundColor) ? ds.backgroundColor[j] : ds.backgroundColor;
            ctx.fillStyle = ["{{ c.silver }}", "{{ c.silver_shadow }}"].includes(bgc) ? "{{ c.charcoal }}" : "{{ c.white }}";
            ctx.textAlign = "center"; ctx.textBaseline = "middle";
            ctx.fillText(fmt(v), p.x, p.y);
            return;
          }
          ctx.fillStyle = fg;
          if (isH) { ctx.textAlign = "left"; ctx.textBaseline = "middle"; ctx.fillText(fmt(v), el.x + 8, el.y); }
          else { ctx.textAlign = "center"; ctx.textBaseline = "bottom"; ctx.fillText(fmt(v), el.x, el.y - 6); }
        });
      });
      ctx.restore();
    }
  };

  const scales = type === "doughnut" ? {} : {
    x: { grid: { display: isH, color: grid }, border: { color: grid },
         ticks: { color: fg2, font: { weight: 600 } }, ...(isH ? { beginAtZero: true, grace: "18%", ticks: { display: false } } : {}) },
    y: { grid: { display: !isH, color: grid }, border: { display: false },
         ticks: { color: fg2, font: { weight: 600 } }, ...(isH ? {} : { beginAtZero: kind !== "line", grace: "15%", ticks: { display: false } }) },
  };

  const chart = new Chart(document.getElementById("c"), {
    type,
    data: { labels: spec.labels, datasets },
    options: {
      indexAxis: isH ? "y" : "x",
      animation: false, responsive: true, maintainAspectRatio: false, devicePixelRatio: 2,
      layout: { padding: { top: 24, right: isH ? 12 : 0 } },
      cutout: "58%",
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales,
    },
    plugins: [valueLabels],
  });

  const legend = document.getElementById("legend");
  if (legend) {
    const items = type === "doughnut"
      ? spec.labels.map((l, j) => [l, colors[j % colors.length]])
      : spec.datasets.map((d, i) => [d.label, colors[seriesOrder[i % seriesOrder.length]]]);
    legend.innerHTML = items.map(([l, col]) => `<span><i style="background:${col}"></i>${l}</span>`).join("");
  }
  window.__ready = true;
})();
</script>
{% endblock %}
